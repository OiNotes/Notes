# Neon PostgreSQL (get connection string from neon.tech or Vercel dashboard)
# Use `vercel env pull .env.local` to auto-download from Vercel
POSTGRES_PRISMA_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?connect_timeout=15&sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Admin PIN for studio access (change in production!)
ADMIN_PIN="change-me"
